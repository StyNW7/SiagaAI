# ─────────────────────────────────────────────────────────────────────────────
# SiagaAI environment variables. Copy to `.env` (repo root) — NEVER commit `.env`.
# All integrations are optional: without keys, SiagaAI falls back gracefully
# (local AI reasoner, public NASA FIRMS feed, local-device storage).
# ─────────────────────────────────────────────────────────────────────────────

# ── Server-side secrets (used ONLY by /api serverless functions; never shipped to the browser)
# Google Gemini (free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Groq (free tier: https://console.groq.com/keys) — used if Gemini is missing/fails.
# Retired or overloaded models fall through to built-in candidates automatically.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# OpenRouter (free models: https://openrouter.ai/keys) — third fallback
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# NASA FIRMS MAP_KEY (optional; public 7-day CSV feeds are used when empty)
FIRMS_MAP_KEY=

# ── Public client config (VITE_ prefix = bundled into the frontend; must not be secret)
# Supabase (optional). Anon key is public by design and protected by Row Level Security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: override AI endpoint, e.g. Supabase Edge Function URL
# VITE_AI_ENDPOINT=https://<project>.supabase.co/functions/v1/siaga-ai
