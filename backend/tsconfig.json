{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["core/**/*.ts", "../api/**/*.ts", "../ai/**/*.ts", "env.d.ts"],
  "exclude": ["core/**/*.test.ts"]
}
